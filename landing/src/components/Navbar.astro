---
import { getLangFromUrl, useTranslations, getLocalizedPath, otherLangPath } from '@/i18n/utils';
import { languages } from '@/i18n/ui';
import CompanionFace from '@/components/CompanionFace.astro';
import CoatPicker from '@/components/CoatPicker.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = lang === 'en' ? 'fr' : 'en';

const links = [
  { href: getLocalizedPath(lang, '#what'), label: t('nav.what') },
  { href: getLocalizedPath(lang, '#free'), label: t('nav.free') },
  { href: getLocalizedPath(lang, '#companion'), label: t('nav.companion') },
  { href: lang === 'fr' ? '/fr/manuel' : '/manual', label: t('nav.manual') },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md">
  <nav class="wrap flex items-center justify-between gap-4 py-3" aria-label="TTP">
    <a href={getLocalizedPath(lang)} class="flex items-center gap-2 text-[1.05rem] font-semibold tracking-tight">
      {/* The wordmark blinks. It is the cheapest possible demonstration that
          the face is a real thing with a real clock, and it costs one 16px
          SVG and two setTimeouts. */}
      <span class="text-accent"><CompanionFace variety="house" uid="nav" size={18} /></span>
      <span>TTP</span>
    </a>

    <div class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-muted transition-colors hover:text-text">{l.label}</a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <CoatPicker lang={lang} />

      <button
        type="button"
        data-appearance-toggle
        class="grid h-9 w-9 place-items-center rounded-[var(--r-sm)] border border-line text-muted transition-colors hover:text-text"
        aria-label={t('nav.appearance')}
        title={t('nav.appearance')}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon-light>
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
        </svg>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" data-icon-dark class="hidden">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
        </svg>
      </button>

      <a
        href={otherLangPath(Astro.url, other)}
        data-lang-switch={other}
        hreflang={other}
        class="hidden rounded-[var(--r-sm)] border border-line px-2.5 py-1.5 text-xs font-medium text-muted transition-colors hover:text-text sm:block"
      >
        {languages[other]}
      </a>

      <a href={getLocalizedPath(lang, '#install')} class="btn btn-primary hidden !py-2 !text-sm md:inline-flex">
        {t('nav.download')}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="grid h-9 w-9 place-items-center rounded-[var(--r-sm)] border border-line text-muted md:hidden"
        aria-label={t('nav.menu')}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-nav" hidden class="border-t border-line md:hidden">
    <div class="wrap flex flex-col gap-1 py-3">
      {links.map((l) => (
        <a href={l.href} class="rounded-[var(--r-sm)] px-2 py-2 text-sm text-muted hover:bg-raised hover:text-text">{l.label}</a>
      ))}
      <a href={getLocalizedPath(lang, '#install')} class="rounded-[var(--r-sm)] px-2 py-2 text-sm font-semibold text-accent">
        {t('nav.download')}
      </a>
      <a href={otherLangPath(Astro.url, other)} data-lang-switch={other} class="rounded-[var(--r-sm)] px-2 py-2 text-sm text-muted">
        {languages[other]}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      try { localStorage.setItem('lang', el.dataset.langSwitch as string); } catch {}
    });
  });

  /* Appearance. Three states, cycled in the order a person expects: whatever
     the system says → the opposite of what they are looking at → back to the
     system. The attribute is what the stylesheet reads; localStorage is only
     how it survives a reload. */
  const root = document.documentElement;
  const appearanceButton = document.querySelector<HTMLButtonElement>('[data-appearance-toggle]');
  const sun = document.querySelector<SVGElement>('[data-icon-light]');
  const moon = document.querySelector<SVGElement>('[data-icon-dark]');

  function isDark() {
    const set = root.getAttribute('data-appearance');
    if (set === 'dark') return true;
    if (set === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function syncIcon() {
    const dark = isDark();
    sun?.classList.toggle('hidden', dark);
    moon?.classList.toggle('hidden', !dark);
  }

  appearanceButton?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-appearance', next);
    try { localStorage.setItem('ttp-appearance', next); } catch {}
    syncIcon();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncIcon);
  syncIcon();
</script>
