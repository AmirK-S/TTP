---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const buyUrl = 'https://amirks.lemonsqueezy.com/buy/dcc74241-21ae-4d20-8a3c-90bf8d842bae';

const freeFeatures = [
  t('pricing.free.feat1'),
  t('pricing.free.feat2'),
  t('pricing.free.feat3'),
  t('pricing.free.feat4'),
];

const proFeatures = [
  t('pricing.pro.feat1'),
  t('pricing.pro.feat2'),
  t('pricing.pro.feat3'),
  t('pricing.pro.feat4'),
];
---

<section id="pricing" data-snap-section data-section-pricing class="relative px-6 py-32 md:py-48">
  <div class="mx-auto max-w-5xl">
    <!-- Section heading -->
    <div data-pricing-heading class="mb-16 md:mb-20 text-center">
      <h2 class="text-heading font-bold tracking-tight">
        <span class="inline-block bg-gradient-to-r from-zinc-900 to-zinc-500 bg-clip-text text-transparent dark:from-white dark:to-slate-400">
          {t('pricing.heading')}
        </span>
      </h2>
      <p class="mt-4 text-body-lg text-zinc-600 dark:text-slate-400">
        {t('pricing.subheading')}
      </p>
    </div>

    <!-- Pricing grid: Free | Pro -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8" data-spotlight>
      <!-- Free tier -->
      <div data-pricing-card data-spotlight-card class="group relative overflow-hidden flex flex-col rounded-2xl border border-black/[0.06] bg-white p-8 shadow-sm shadow-black/[0.03] transition-colors hover:border-black/[0.12] hover:shadow-md hover:shadow-black/[0.04] dark:border-white/10 dark:bg-white/[0.05] dark:backdrop-blur-sm dark:shadow-none dark:hover:border-white/20 dark:hover:bg-white/[0.07]">
        <!-- Tier label -->
        <div class="mb-2">
          <span class="text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-slate-400">
            {t('pricing.free.label')}
          </span>
        </div>

        <!-- Tier name -->
        <h3 class="mb-2 text-2xl font-bold text-zinc-900 dark:text-white">
          {t('pricing.free.name')}
        </h3>

        <!-- Price -->
        <div class="mb-1 flex items-baseline gap-2">
          <span class="text-5xl font-extrabold text-zinc-900 dark:text-white">
            {t('pricing.free.price')}
          </span>
        </div>
        <p class="mb-8 text-sm text-zinc-600 dark:text-slate-400">
          {t('pricing.free.priceSub')}
        </p>

        <!-- Features list -->
        <ul class="mb-8 flex flex-col gap-3">
          {freeFeatures.map((feature) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-zinc-500 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
              </svg>
              <span class="text-sm leading-relaxed text-zinc-700 dark:text-slate-300">{feature}</span>
            </li>
          ))}
        </ul>

        <!-- CTA (free) -->
        <div class="mt-auto">
          <a
            href="#install"
            class="block w-full rounded-full border border-black/[0.08] bg-white px-6 py-3 text-center text-sm font-medium text-zinc-900 transition-colors hover:bg-zinc-50 dark:border-white/10 dark:bg-white/[0.03] dark:text-white dark:hover:bg-white/[0.08]"
          >
            {t('pricing.free.cta')}
          </a>
        </div>
      </div>

      <!-- Pro tier (highlighted) -->
      <div data-pricing-card data-pricing-pro class="group relative overflow-hidden rounded-2xl">
        <!-- Animated gradient border -->
        <div class="gradient-border-animated h-full">
          <div class="relative flex h-full flex-col rounded-[calc(1rem-1px)] bg-gradient-to-br from-blue-50 via-white to-white p-8 shadow-sm shadow-blue-600/[0.05] dark:from-violet-950/40 dark:via-slate-950/95 dark:to-slate-950/95 dark:backdrop-blur-sm dark:shadow-none" data-spotlight-card>
            <!-- "Recommended" badge -->
            <div class="absolute right-6 top-6">
              <span class="inline-flex items-center rounded-full border border-blue-600/20 bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blue-700 dark:border-violet-500/30 dark:bg-violet-500/10 dark:text-violet-300">
                {t('pricing.pro.badge')}
              </span>
            </div>

            <!-- Tier label -->
            <div class="mb-2">
              <span class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-violet-300">
                {t('pricing.pro.label')}
              </span>
            </div>

            <!-- Tier name -->
            <h3 class="mb-2 text-2xl font-bold text-zinc-900 dark:text-white">
              {t('pricing.pro.name')}
            </h3>

            <!-- Price -->
            <div class="mb-1 flex items-baseline gap-2">
              <span class="text-5xl font-extrabold text-zinc-900 dark:text-white">€17</span>
            </div>
            <p class="mb-8 text-sm text-zinc-600 dark:text-slate-400">
              {t('pricing.pro.priceSub')}
            </p>

            <!-- Features list -->
            <ul class="mb-8 flex flex-col gap-3">
              {proFeatures.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-blue-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span class="text-sm leading-relaxed text-zinc-700 dark:text-slate-200">{feature}</span>
                </li>
              ))}
            </ul>

            <!-- CTA (Pro) -->
            <div class="mt-auto">
              <a
                href={buyUrl}
                target="_blank"
                rel="noopener"
                class="block w-full rounded-full bg-blue-600 px-6 py-3 text-center text-sm font-semibold text-white shadow-md shadow-blue-600/25 transition-all hover:bg-blue-700 hover:shadow-blue-600/35 dark:bg-gradient-to-r dark:from-violet-500 dark:to-fuchsia-500 dark:shadow-violet-500/25 dark:hover:from-violet-400 dark:hover:to-fuchsia-400 dark:hover:shadow-violet-500/40"
              >
                {t('pricing.pro.cta')}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector("[data-section-pricing]");
  if (section) {
    const mm = gsap.matchMedia();

    mm.add({
      isDesktop: "(min-width: 768px) and (prefers-reduced-motion: no-preference)",
      isMobile: "(max-width: 767px) and (prefers-reduced-motion: no-preference)",
      reduceMotion: "(prefers-reduced-motion: reduce)",
    }, (context) => {
      const { isDesktop, isMobile, reduceMotion } = context.conditions;
      if (reduceMotion) return;

      const heading = section.querySelector("[data-pricing-heading]");
      const cards = gsap.utils.toArray("[data-pricing-card]");

      if (isDesktop) {
        gsap.from(heading, {
          opacity: 0,
          y: 30,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: heading,
            start: "top 80%",
            once: true,
          },
        });

        gsap.from(cards, {
          opacity: 0,
          y: 60,
          duration: 0.8,
          ease: "power2.out",
          stagger: 0.15,
          scrollTrigger: {
            trigger: section,
            start: "top 60%",
            once: true,
          },
        });
      }

      if (isMobile) {
        gsap.from(heading, {
          opacity: 0,
          y: 20,
          duration: 0.6,
          scrollTrigger: { trigger: heading, start: "top 85%", once: true },
        });

        gsap.from(cards, {
          opacity: 0,
          y: 30,
          stagger: 0.15,
          duration: 0.6,
          ease: "power2.out",
          scrollTrigger: { trigger: cards[0] as Element, start: "top 85%", once: true },
        });
      }
    });
  }
</script>
