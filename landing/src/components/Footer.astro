---
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n/utils';
import { BUY_URL, REPO_URL } from '@/lib/coats';
import CompanionFace from '@/components/CompanionFace.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const manualPath = lang === 'fr' ? '/fr/manuel' : '/manual';

const columns = [
  {
    title: t('footer.product'),
    links: [
      { label: t('footer.download'), href: getLocalizedPath(lang, '#install') },
      { label: t('footer.changelog'), href: getLocalizedPath(lang, '#changelog') },
      { label: t('footer.github'), href: REPO_URL, external: true },
    ],
  },
  {
    title: t('footer.about'),
    links: [
      { label: t('footer.manual'), href: manualPath },
      { label: t('footer.companion'), href: BUY_URL, external: true },
    ],
  },
  {
    title: t('footer.legal'),
    links: [
      { label: t('footer.privacy'), href: getLocalizedPath(lang, 'privacy') },
      { label: t('footer.terms'), href: getLocalizedPath(lang, 'terms') },
    ],
  },
];
---

<footer class="border-t border-line bg-surface">
  <div class="wrap py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.4fr)_repeat(3,minmax(0,1fr))]">
      <div>
        <p class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <span class="text-accent"><CompanionFace variety="bead" uid="footer" size={18} auto /></span>
          TTP
          <span class="text-sm font-normal text-faint">— {t('footer.tagline')}</span>
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted">{t('footer.blurb')}</p>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.title}>
          <h2 class="mono mb-3 text-xs uppercase tracking-[0.14em] text-faint">{col.title}</h2>
          <ul class="grid gap-2">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-muted transition-colors hover:text-text"
                  {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-faint sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Amir Kellousi-Dhoum · {t('footer.made')}</p>
      <p>{t('footer.colophon')}</p>
    </div>
  </div>
</footer>
