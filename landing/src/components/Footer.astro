---
import { getLangFromUrl, getLocalizedPath, otherLangPath, useTranslations } from '@/i18n/utils';
import { languages } from '@/i18n/ui';
import { RELEASES_URL, REPO_URL } from '@/lib/links';
import Logo from '@/components/Logo.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const other = lang === 'en' ? 'fr' : 'en';
const year = new Date().getFullYear();

const links = [
  { label: t('footer.download'), href: getLocalizedPath(lang, '#download') },
  { label: t('footer.releases'), href: RELEASES_URL, external: true },
  { label: t('footer.github'), href: REPO_URL, external: true },
  { label: t('footer.privacy'), href: getLocalizedPath(lang, 'privacy') },
  { label: t('footer.terms'), href: getLocalizedPath(lang, 'terms') },
];
---

<footer class="border-t border-line">
  <div class="wrap flex flex-col gap-8 py-12 md:flex-row md:items-start md:justify-between">
    <div>
      <a href={getLocalizedPath(lang)} class="text-[1.5rem]" aria-label="TTP"><Logo /></a>
      <p class="mt-3 text-sm text-muted">{t('footer.tagline')}</p>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-muted transition-colors hover:text-text"
          {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {l.label}
        </a>
      ))}
      <a href={otherLangPath(Astro.url, other)} data-lang-switch={other} hreflang={other} class="text-muted transition-colors hover:text-text">
        {languages[other]}
      </a>
    </nav>
  </div>
  <div class="wrap">
    <div class="flex flex-col gap-1 border-t border-line py-6 text-[0.8125rem] text-faint sm:flex-row sm:justify-between">
      <p>© {year} · {t('footer.made')}</p>
      <p>{t('footer.clean')}</p>
    </div>
  </div>
</footer>
