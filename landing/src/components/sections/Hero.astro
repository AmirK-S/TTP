---
/**
 * The hero: one sentence, the download, and a desktop where the real pill
 * dictates into three apps. The pill is drawn from FloatingBar.tsx — black,
 * red dot, sixteen bars, a timer; "Transcription…" with a spinner; a double
 * tick — so what people see here is what they get.
 *
 * The demo only runs while it is on screen and the tab is visible, has a
 * pause button, and rests on its finished frame for reduced motion.
 */
import { useTranslations, type Lang } from '@/i18n/utils';
import CopyCommand from '@/components/CopyCommand.astro';

interface Props { lang: Lang; macUrl: string; macIntelUrl: string; version: string }
const { lang, macUrl, macIntelUrl, version } = Astro.props;
const t = useTranslations(lang);

const scenes = [
  { id: 'chat', label: t('stage.sceneChat') },
  { id: 'mail', label: t('stage.sceneMail') },
  { id: 'screen', label: t('stage.sceneScreen') },
] as const;

const apps = ['Slack', 'Gmail', 'Notion', 'Claude', 'ChatGPT', 'Cursor', 'WhatsApp', 'Messages', 'Word', 'Linear'];
const fillers = lang === 'fr' ? ['euh', 'hein', 'alors', 'enfin', 'pardon'] : ['uh', 'um', 'so', 'like', 'sorry'];
---

<section class="relative overflow-hidden pb-20 pt-12 sm:pb-28 sm:pt-20">
  <div aria-hidden="true" class="hero-glow pointer-events-none absolute inset-x-0 top-[-12rem] -z-10 mx-auto h-[44rem] max-w-[80rem]"></div>

  <div class="wrap flex flex-col items-center text-center">
    <p class="badge anim-rise" style="--d:0ms">
      <span class="badge-dot"></span>{t('hero.badge')}
    </p>

    <h1 class="display h-hero mt-7 anim-rise" style="--d:60ms">
      <span class="block">{t('hero.title1')}</span>
      <span class="text-gradient block pb-[0.08em]">{t('hero.title2')}</span>
    </h1>

    <p class="lede mt-6 max-w-[36rem] anim-rise" style="--d:120ms">{t('hero.sub')}</p>

    <div class="mt-9 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row anim-rise" style="--d:180ms">
      <a href={macUrl} class="btn btn-primary btn-lg w-full sm:w-auto">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
        {t('hero.cta')}
      </a>
      <CopyCommand lang={lang} class="w-full justify-between sm:w-auto" />
    </div>

    <p class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[0.8125rem] text-faint anim-rise" style="--d:220ms">
      <span>v{version}</span>
      <span aria-hidden="true">·</span>
      <a href={macIntelUrl} class="underline-offset-4 hover:text-text hover:underline">{t('hero.intel')}</a>
      <span aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        {t('hero.signed')}
      </span>
    </p>
  </div>

  <!-- The stage -->
  <div class="wrap mt-14 sm:mt-20 anim-rise" style="--d:300ms">
    <figure class="stage" data-stage aria-label={t('stage.label')}>
      <div class="stage-screen">
        <div class="menubar" aria-hidden="true">
          <span class="flex items-center gap-4">
            <span class="font-semibold" data-app-name>{t('stage.chatApp')}</span>
            <span class="hidden opacity-70 sm:inline">{lang === 'fr' ? 'Fichier' : 'File'}</span>
            <span class="hidden opacity-70 sm:inline">{lang === 'fr' ? 'Édition' : 'Edit'}</span>
          </span>
          <span class="flex items-center gap-3">
            <span class="menubar-tray" data-tray>TTP<b></b></span>
            <span class="tabular-nums opacity-80">{lang === 'fr' ? 'mar. 09:41' : 'Tue 9:41 AM'}</span>
          </span>
        </div>

        <div class="window">
          <!-- chat -->
          <div class="scene" data-scene="chat" data-active>
            <div class="window-bar">
              <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-title">{t('stage.chatWith')}</span>
            </div>
            <div class="flex flex-col justify-end gap-1.5 px-4 pb-3 pt-4 text-left sm:min-h-[13rem]" data-thread>
              <p class="mb-1 hidden text-center text-[0.6875rem] text-faint sm:block">{lang === 'fr' ? 'Aujourd’hui 09:32' : 'Today 9:32 AM'}</p>
              <p class="bubble bubble-out hidden !bg-[#0a84ff]/90 sm:block">{lang === 'fr' ? 'Je t’envoie la maquette ce matin' : 'Sending you the mockup this morning'}</p>
              <div class="mt-1.5 flex items-end gap-2">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-gradient-to-b from-[#a1a1aa] to-[#71717a] text-[0.6875rem] font-semibold text-white">J</span>
                <div class="grid gap-1">
                  <p class="bubble bubble-in hidden !max-w-none sm:block">{lang === 'fr' ? 'Top, merci !' : 'Great, thanks!'}</p>
                  <p class="bubble bubble-in !max-w-none">{t('stage.chatIncoming')}</p>
                </div>
              </div>
              <p class="bubble bubble-out" data-sent hidden></p>
            </div>
            <div class="border-t border-line px-3 py-2.5">
              <p class="min-h-[2.25rem] rounded-[18px] border border-line-strong px-3.5 py-[0.45rem] text-left text-[0.875rem]">
                <span data-target></span><span class="field-caret" data-caret></span><span class="text-faint" data-placeholder>{t('stage.chatPlaceholder')}</span>
              </p>
            </div>
          </div>

          <!-- mail -->
          <div class="scene" data-scene="mail">
            <div class="window-bar">
              <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-title">{t('stage.mailSubjectValue')}</span>
            </div>
            <div class="text-left text-[0.875rem]">
              <p class="flex gap-2 border-b border-line px-4 py-2.5"><span class="text-faint">{t('stage.mailTo')}</span><span class="rounded-full bg-[color-mix(in_srgb,var(--accent)_14%,transparent)] px-2 text-accent">{t('stage.mailToValue')}</span></p>
              <p class="flex gap-2 border-b border-line px-4 py-2.5"><span class="text-faint">{t('stage.mailSubject')}</span><span class="font-medium">{t('stage.mailSubjectValue')}</span></p>
              <div class="min-h-[8rem] px-4 py-4 leading-relaxed sm:min-h-[10.5rem]">
                <p>{t('stage.mailHello')}</p>
                <p class="mt-3"><span data-target></span><span class="field-caret" data-caret></span></p>
              </div>
            </div>
          </div>

          <!-- screen context -->
          <div class="scene" data-scene="screen">
            <div class="window-bar">
              <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="window-title">{t('stage.screenApp')}</span>
            </div>
            <div class="relative min-h-[12.5rem] px-5 py-5 sm:min-h-[14.5rem] text-left text-[0.875rem] leading-relaxed">
              <p class="text-[1.25rem] font-semibold tracking-[-0.02em]">{t('stage.screenDocTitle')}</p>
              <ul class="mt-2 list-disc pl-5 text-muted marker:text-faint">
                <li>
                  {t('stage.screenDocLine').split('Claude Code')[0]}<mark class="screen-word rounded bg-transparent px-0.5 text-text transition-[background-color,box-shadow] duration-300" data-screen-word>Claude Code</mark>{t('stage.screenDocLine').split('Claude Code')[1]}
                </li>
              </ul>
              <p class="mt-3"><span data-target></span><span class="field-caret" data-caret></span></p>
              <p class="screen-badge mt-4 inline-flex items-center gap-1.5 rounded-full border border-line bg-bg px-2.5 py-1 text-[0.75rem] text-muted shadow-[var(--shadow-sm)]" data-badge>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 8h8M7 12h10M7 16h6"/></svg>
                {t('stage.screenBadge')} · <b class="font-medium text-text">Claude Code</b>
              </p>
            </div>
          </div>
        </div>

        <p class="caption" data-caption aria-hidden="true"><span data-caption-text></span></p>

        <div class="stage-pill" data-pill data-state="rec" aria-hidden="true">
          <span class="pill">
            <span data-part="rec">
              <span class="pill-rec"></span>
              <span class="pill-bars" data-bars>{Array.from({ length: 16 }).map(() => <i></i>)}</span>
              <span class="tabular-nums text-white/90" data-timer>0:00</span>
            </span>
            <span data-part="proc">
              <span class="pill-spin"></span>
              <span class="text-white/90">{t('stage.transcribing')}</span>
            </span>
            <span data-part="done">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 7 17l-5-5"/><path d="m22 10-7.5 7.5L13 16"/></svg>
            </span>
          </span>
        </div>
      </div>
    </figure>

    <div class="mt-5 flex items-center justify-center gap-2">
      <div class="scene-tabs" role="tablist" aria-label={t('stage.label')}>
        {scenes.map((s, i) => (
          <button type="button" role="tab" class="scene-tab" data-tab={i} aria-selected={i === 0 ? 'true' : 'false'}>
            {s.label}<span class="progress" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <button type="button" class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-muted transition-colors hover:bg-surface hover:text-text" data-toggle data-label-pause={t('stage.pause')} data-label-play={t('stage.play')} aria-label={t('stage.pause')}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-pause><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon-play hidden><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
      </button>
    </div>
  </div>

  <!-- Where it works -->
  <div class="wrap mt-16 flex flex-col items-center gap-5 text-center" data-reveal>
    <p class="text-sm text-muted">{t('apps.lead')}</p>
    <ul class="flex max-w-3xl flex-wrap justify-center gap-2">
      {apps.map((a) => <li class="chip">{a}</li>)}
    </ul>
  </div>

  <script
    is:inline
    type="application/json"
    data-stage-copy
    set:html={JSON.stringify({
      fillers,
      scenes: {
        chat: { app: t('stage.chatApp'), said: t('stage.chatSaid'), clean: t('stage.chatClean') },
        mail: { app: t('stage.mailApp'), said: t('stage.mailSaid'), clean: t('stage.mailClean') },
        screen: { app: t('stage.screenApp'), said: t('stage.screenSaid'), clean: t('stage.screenClean') },
      },
    })}
  />
</section>

<style>
  .hero-glow {
    background:
      radial-gradient(40% 45% at 50% 40%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(30% 35% at 30% 55%, color-mix(in srgb, #8b5cf6 9%, transparent), transparent 70%),
      radial-gradient(30% 35% at 72% 55%, color-mix(in srgb, #06b6d4 7%, transparent), transparent 70%);
    filter: blur(20px);
  }

  :global(html.js) .anim-rise { animation: rise 900ms var(--ease-out) both; animation-delay: var(--d, 0ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }

  .screen-badge { opacity: 0; transform: translateY(6px); transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out); }
  [data-scene][data-context] .screen-badge { opacity: 1; transform: none; }
  [data-scene][data-context] .screen-word {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
  }
</style>

<script>
  type SceneId = 'chat' | 'mail' | 'screen';
  interface Copy {
    fillers: string[];
    scenes: Record<SceneId, { app: string; said: string; clean: string }>;
  }

  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const copyNode = document.querySelector<HTMLScriptElement>('[data-stage-copy]');

  if (stage && copyNode) {
    const copy = JSON.parse(copyNode.textContent ?? '{}') as Copy;
    const ORDER: SceneId[] = ['chat', 'mail', 'screen'];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pill = stage.querySelector<HTMLElement>('[data-pill]')!;
    const bars = Array.from(stage.querySelectorAll<HTMLElement>('[data-bars] i'));
    const timer = stage.querySelector<HTMLElement>('[data-timer]')!;
    const caption = stage.querySelector<HTMLElement>('[data-caption]')!;
    const captionText = stage.querySelector<HTMLElement>('[data-caption-text]')!;
    const appName = stage.querySelector<HTMLElement>('[data-app-name]')!;
    const tray = stage.querySelector<HTMLElement>('[data-tray]')!;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const iconPause = toggle.querySelector<SVGElement>('[data-icon-pause]')!;
    const iconPlay = toggle.querySelector<SVGElement>('[data-icon-play]')!;

    let current = 0;
    let paused = reduced;
    let visible = false;
    let running = false;
    let timers: number[] = [];
    let barTicker: number | undefined;
    let progressTicker: number | undefined;

    const at = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };
    const sceneEl = (id: SceneId) => stage.querySelector<HTMLElement>(`[data-scene="${id}"]`)!;

    function clearAll() {
      timers.forEach(window.clearTimeout);
      timers = [];
      window.clearInterval(barTicker);
      window.clearInterval(progressTicker);
      barTicker = progressTicker = undefined;
      running = false;
    }

    function setProgress(i: number, p: number) {
      tabs.forEach((tab, k) => tab.style.setProperty('--p', k === i ? String(Math.min(p, 1)) : '0'));
    }

    function show(i: number) {
      current = i;
      const id = ORDER[i];
      ORDER.forEach((s) => sceneEl(s).toggleAttribute('data-active', s === id));
      tabs.forEach((tab, k) => tab.setAttribute('aria-selected', String(k === i)));
      appName.textContent = copy.scenes[id].app;
    }

    function resetScene(id: SceneId) {
      const el = sceneEl(id);
      const target = el.querySelector<HTMLElement>('[data-target]')!;
      target.textContent = '';
      target.classList.remove('landed');
      el.querySelector<HTMLElement>('[data-caret]')?.removeAttribute('hidden');
      el.querySelector<HTMLElement>('[data-placeholder]')?.removeAttribute('hidden');
      el.removeAttribute('data-context');
      const sent = el.querySelector<HTMLElement>('[data-sent]');
      if (sent) { sent.hidden = true; sent.classList.remove('bubble-send'); }
      pill.removeAttribute('data-on');
      caption.removeAttribute('data-on');
      captionText.textContent = '';
      tray.removeAttribute('data-live');
    }

    /** The finished frame: the clean text where it belongs, nothing moving. */
    function settle(i: number) {
      clearAll();
      show(i);
      const id = ORDER[i];
      resetScene(id);
      const el = sceneEl(id);
      const clean = copy.scenes[id].clean;
      if (id === 'chat') {
        const sent = el.querySelector<HTMLElement>('[data-sent]')!;
        sent.textContent = clean;
        sent.hidden = false;
      } else {
        el.querySelector<HTMLElement>('[data-target]')!.textContent = clean;
        el.querySelector<HTMLElement>('[data-caret]')?.setAttribute('hidden', '');
        if (id === 'screen') el.setAttribute('data-context', '');
      }
      pill.dataset.state = 'done';
      pill.setAttribute('data-on', '');
      setProgress(i, paused ? 0 : 1);
    }

    function startBars() {
      barTicker = window.setInterval(() => {
        bars.forEach((b, k) => {
          const centre = 1 - Math.abs(k - 7.5) / 9;
          const s = 0.18 + Math.random() * 0.82 * centre;
          b.style.transform = `scaleY(${s.toFixed(2)})`;
        });
      }, 80);
    }

    function stopBars() {
      window.clearInterval(barTicker);
      barTicker = undefined;
      bars.forEach((b) => { b.style.transform = ''; });
    }

    function word(w: string) {
      const bare = w.toLowerCase().replace(/[^\p{L}]/gu, '');
      if (copy.fillers.includes(bare)) {
        const em = document.createElement('em');
        em.textContent = w;
        return em;
      }
      return document.createTextNode(w);
    }

    function run(i: number) {
      clearAll();
      show(i);
      const id = ORDER[i];
      resetScene(id);
      running = true;

      const el = sceneEl(id);
      const target = el.querySelector<HTMLElement>('[data-target]')!;
      const caret = el.querySelector<HTMLElement>('[data-caret]');
      const placeholder = el.querySelector<HTMLElement>('[data-placeholder]');
      const { said, clean } = copy.scenes[id];
      const words = said.split(' ');

      const WORD = 185;
      const start = 700;
      const recEnd = start + 250 + words.length * WORD + 450;
      const landAt = recEnd + 1000;
      const total = landAt + (id === 'chat' ? 4200 : 3800);

      const begun = performance.now();
      progressTicker = window.setInterval(() => setProgress(i, (performance.now() - begun) / total), 60);

      at(start, () => {
        pill.dataset.state = 'rec';
        pill.setAttribute('data-on', '');
        tray.setAttribute('data-live', '');
        caption.setAttribute('data-on', '');
        timer.textContent = '0:00';
        startBars();
      });
      for (let s = 1; s * 1000 < recEnd - start; s++) {
        at(start + s * 1000, () => { timer.textContent = `0:${String(s).padStart(2, '0')}`; });
      }
      words.forEach((w, k) => {
        at(start + 250 + k * WORD, () => {
          if (k > 0) captionText.append(' ');
          captionText.append(word(w));
        });
      });

      at(recEnd, () => {
        stopBars();
        pill.dataset.state = 'proc';
        caption.removeAttribute('data-on');
      });

      at(landAt, () => {
        pill.dataset.state = 'done';
        placeholder?.setAttribute('hidden', '');
        target.textContent = clean;
        target.classList.add('landed');
        if (id === 'screen') el.setAttribute('data-context', '');
      });

      at(landAt + 900, () => {
        pill.removeAttribute('data-on');
        tray.removeAttribute('data-live');
        caret?.setAttribute('hidden', '');
      });

      if (id === 'chat') {
        at(landAt + 1500, () => {
          const sent = el.querySelector<HTMLElement>('[data-sent]')!;
          target.textContent = '';
          target.classList.remove('landed');
          placeholder?.removeAttribute('hidden');
          caret?.removeAttribute('hidden');
          sent.textContent = clean;
          sent.hidden = false;
          sent.classList.add('bubble-send');
        });
      }

      at(total, () => run((i + 1) % ORDER.length));
    }

    function setPaused(next: boolean) {
      paused = next;
      toggle.setAttribute('aria-label', (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? '');
      iconPause.toggleAttribute('hidden', paused);
      iconPlay.toggleAttribute('hidden', !paused);
      if (paused) settle(current);
      else if (visible) run(current);
    }

    tabs.forEach((tab, k) => tab.addEventListener('click', () => {
      if (paused) settle(k);
      else run(k);
    }));
    toggle.addEventListener('click', () => setPaused(!paused));

    setPaused(paused);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          if (paused) return;
          if (visible && !running) run(current);
          if (!visible && running) settle(current);
        },
        { threshold: 0.3 },
      ).observe(stage);
    }

    document.addEventListener('visibilitychange', () => {
      if (paused) return;
      if (document.hidden && running) settle(current);
      else if (!document.hidden && visible && !running) run(current);
    });
  }
</script>
