---
/**
 * The one piece of friction, said before the download rather than discovered
 * at the setup screen: a Groq key. Owning it turns it into the reason TTP is
 * free.
 */
import { useTranslations, type Lang } from '@/i18n/utils';
import { GROQ_CONSOLE } from '@/lib/links';
import SectionHead from '@/components/SectionHead.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const steps = [
  { title: t('setup.s1Title'), desc: t('setup.s1Desc') },
  { title: t('setup.s2Title'), desc: t('setup.s2Desc') },
  { title: t('setup.s3Title'), desc: t('setup.s3Desc') },
  { title: t('setup.s4Title'), desc: t('setup.s4Desc') },
];
---

<section id="setup" class="section border-t border-line">
  <div class="wrap grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-20">
    <div>
      <SectionHead eyebrow={t('setup.eyebrow')} title={t('setup.title')} sub={t('setup.sub')} align="left" />

      <ol class="mt-10 grid gap-0" data-reveal>
        {steps.map((s, i) => (
          <li class="relative flex gap-4 pb-7 last:pb-0">
            {i < steps.length - 1 && <span aria-hidden="true" class="absolute left-[0.9375rem] top-9 bottom-1 w-px bg-line"></span>}
            <span class="grid h-[1.875rem] w-[1.875rem] shrink-0 place-items-center rounded-full border border-line-strong bg-surface text-[0.8125rem] font-semibold tabular-nums shadow-[var(--highlight)]">{i + 1}</span>
            <div class="pt-[0.2rem]">
              <h3 class="font-semibold tracking-[-0.01em]">{s.title}</h3>
              <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <a href={GROQ_CONSOLE} target="_blank" rel="noopener" class="btn btn-quiet mt-9" data-reveal>
        {t('setup.cta')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
      </a>
    </div>

    <!-- A drawing of the app's own key step -->
    <div class="setup-visual relative" data-reveal>
      <div class="relative mx-auto max-w-[26rem] overflow-hidden rounded-[14px] border border-line-strong bg-bg shadow-[var(--shadow-lg)]">
        <div class="window-bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="window-title">TTP</span>
        </div>
        <div class="p-7">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-1 flex-1 rounded-full bg-accent"></span>
            <span class="h-1 flex-1 rounded-full bg-accent"></span>
            <span class="h-1 flex-1 rounded-full bg-line"></span>
            <span class="h-1 flex-1 rounded-full bg-line"></span>
          </div>
          <p class="mt-6 text-[1.375rem] font-semibold tracking-[-0.025em]">{t('setup.winTitle')}</p>
          <p class="mt-1.5 text-[0.875rem] leading-relaxed text-muted">{t('setup.winSub')}</p>

          <p class="mt-6 text-[0.8125rem] font-medium">{t('setup.winKey')}</p>
          <p class="mt-2 flex h-10 items-center justify-between rounded-[8px] border border-[color-mix(in_srgb,var(--success)_45%,var(--line-strong))] bg-surface px-3 font-mono text-[0.8125rem] text-muted">
            gsk_••••••••••••••••7Qm2
            <span class="inline-flex items-center gap-1 font-sans text-[0.75rem] font-medium text-[var(--success)]">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {t('setup.winSaved')}
            </span>
          </p>
          <p class="mt-3 text-[0.8125rem] text-faint">{t('setup.winFree')}</p>

          <div class="mt-7 flex justify-end gap-2" aria-hidden="true">
            <span class="btn btn-quiet btn-sm pointer-events-none">{lang === 'fr' ? 'Retour' : 'Back'}</span>
            <span class="btn btn-accent btn-sm pointer-events-none">{lang === 'fr' ? 'Suivant' : 'Next'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .setup-visual { isolation: isolate; }
  .setup-visual::before {
    content: "";
    position: absolute;
    inset: -8% -4%;
    z-index: -1;
    border-radius: 32px;
    background:
      radial-gradient(50% 60% at 30% 30%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(45% 55% at 75% 75%, color-mix(in srgb, #8b5cf6 12%, transparent), transparent 70%);
    filter: blur(24px);
  }
</style>
