---
import '@/styles/site.css';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Canonical path of this page in the other language, for hreflang. */
  altPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description'), altPath } = Astro.props;

const SITE = 'https://ttp.amirks.eu';
const here = `${SITE}${Astro.url.pathname}`;
---

<!doctype html>
<html lang={lang} data-coat="wild">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="canonical" href={here} />
    {altPath && <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={`${SITE}${altPath}`} />}
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TTP — Talk To Paste" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/ttp-logo-1024.png`} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:url" content={here} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/ttp-logo-1024.png`} />

    {/* One offer, one price, and it is named for what it is. The old markup
        advertised a "Pro" tier next to a "Free" one, which is exactly the
        reading the product no longer supports. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'TTP — Talk To Paste',
      description,
      url: SITE,
      downloadUrl: 'https://github.com/AmirK-S/TTP/releases',
      operatingSystem: ['macOS', 'Windows'],
      applicationCategory: 'ProductivityApplication',
      image: `${SITE}/ttp-logo-1024.png`,
      author: { '@type': 'Person', name: 'Amir Kellousi-Dhoum', url: 'https://amirks.eu' },
      offers: {
        '@type': 'Offer',
        name: 'The application',
        price: '0',
        priceCurrency: 'EUR',
        description: 'Every feature, uncapped. Requires a free Groq API key of your own.',
      },
    })} />

    <title>{title}</title>

    {/* Before first paint: restore the coat and appearance the visitor last
        chose, and mark the document as scripted so the reveal animations may
        start hidden. Without JS nothing is hidden and nothing is lost. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var c = localStorage.getItem('ttp-coat');
          if (c && ['wild', 'roan', 'piebald', 'merle', 'tortie'].indexOf(c) >= 0) d.setAttribute('data-coat', c);
          var a = localStorage.getItem('ttp-appearance');
          if (a === 'light' || a === 'dark') d.setAttribute('data-appearance', a);
        } catch (e) {}
      })();
    </script>

    {/* Language preference, honoured only on the bare root so a shared deep
        link is never redirected out from under the person who was sent it. */}
    <script is:inline>
      (function () {
        if (location.pathname !== '/' && location.pathname !== '/index.html') return;
        var s = null;
        try { s = localStorage.getItem('lang'); } catch (e) {}
        if (s === 'en') return;
        if (s === 'fr') { location.replace('/fr/' + location.hash); return; }
        var langs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < langs.length; i++) {
          if (langs[i].indexOf('fr') === 0) { location.replace('/fr/' + location.hash); return; }
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg">
      {t('nav.skip')}
    </a>
    <slot />

    <script>
      /* Reveal on scroll. One observer, no library, and it unobserves as it
         goes, so a long page does not keep a live callback per section. */
      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }

      /* Faces that belong to no sequence — the wordmark, the footer — just
         idle and blink. They are started here rather than in each component so
         there is exactly one import of the driver on the page. */
      const auto = document.querySelectorAll<HTMLElement>('[data-face-auto]');
      if (auto.length) {
        const { mountFace } = await import('@/lib/face');
        auto.forEach((el) => {
          const id = el.dataset.face;
          if (id) mountFace(el, id as Parameters<typeof mountFace>[1]);
        });
      }
    </script>
  </body>
</html>
