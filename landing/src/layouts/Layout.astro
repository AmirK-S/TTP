---
import '@/styles/site.css';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Canonical path of this page in the other language, for hreflang. */
  altPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t('meta.title'), description = t('meta.description'), altPath } = Astro.props;

const SITE = 'https://ttp.amirks.eu';
const here = `${SITE}${Astro.url.pathname}`;
const ogImage = `${SITE}/${lang === 'fr' ? 'og.png' : 'og-en.png'}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <link rel="preload" as="font" type="font/woff2" href={interWoff2} crossorigin="anonymous" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/ttp-logo-1024.png" />
    <link rel="canonical" href={here} />
    {altPath && <link rel="alternate" hreflang={lang === 'en' ? 'fr' : 'en'} href={`${SITE}${altPath}`} />}
    <link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TTP — Talk To Paste" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={here} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'TTP — Talk To Paste',
      description,
      url: SITE,
      downloadUrl: 'https://github.com/AmirK-S/TTP/releases',
      operatingSystem: 'macOS',
      applicationCategory: 'ProductivityApplication',
      image: `${SITE}/ttp-logo-1024.png`,
      author: { '@type': 'Person', name: 'Amir Kellou-Sidhoum', url: 'https://amirks.eu' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    })} />

    <title>{title}</title>

    {/* Marks the document as scripted so reveal animations may start hidden.
        Without JS nothing is hidden. */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    {/* Language preference, honoured only on the bare root so a shared deep
        link is never redirected out from under the person who was sent it. */}
    <script is:inline>
      (function () {
        if (location.pathname !== '/' && location.pathname !== '/index.html') return;
        var s = null;
        try { s = localStorage.getItem('lang'); } catch (e) {}
        if (s === 'en') return;
        if (s === 'fr') { location.replace('/fr/' + location.hash); return; }
        var langs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < langs.length; i++) {
          if (langs[i].indexOf('fr') === 0) { location.replace('/fr/' + location.hash); return; }
        }
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-text focus:px-4 focus:py-2 focus:text-bg">
      {t('nav.skip')}
    </a>
    <slot />

    <script>
      /* Fade-in on arrival. One observer; it unobserves as it goes. It never
         scrolls anything. */
      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('in'));
      }

      /* Copy buttons for the install command, wherever they appear. */
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        const label = button.querySelector<HTMLElement>('[data-copy-label]');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
          } catch {
            return;
          }
          if (!label) return;
          button.setAttribute('data-done', '');
          label.textContent = label.dataset.done ?? '';
          window.setTimeout(() => {
            button.removeAttribute('data-done');
            label.textContent = label.dataset.idle ?? '';
          }, 1800);
        });
      });

      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((el) => {
        el.addEventListener('click', () => {
          try { localStorage.setItem('lang', el.dataset.langSwitch as string); } catch {}
        });
      });
    </script>
  </body>
</html>
